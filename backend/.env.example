# Neon(PostgreSQL) 연결 문자열
# https://console.neon.tech 에서 프로젝트 생성 후 Connection string 복사
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT 서명키 — 반드시 직접 생성해서 채울 것
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
